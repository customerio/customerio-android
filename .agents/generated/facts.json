  },
  "public_api": {
    "tool": "kotlinx binary-compatibility-validator",
    "check_task": "apiCheck",
    "update_task": "apiDump",
    "dump_files": [
      "core/api/core.api",
      "datapipelines/api/datapipelines.api",
      "geofence/api/geofence.api",
      "location/api/location.api",
      "messaginginapp-compose/api/messaginginapp-compose.api",
      "messaginginapp/api/messaginginapp.api",
      "messaginginbox/api/messaginginbox.api",
      "messagingpush/api/messagingpush.api",
      "tracking-migration/api/tracking-migration.api"
    ],
    "ignored_projects": []
  },
  "make_targets": {
    "e2e": {
      "file": "Makefile",
      "doc": "One-command deterministic Android SDK \u2192 backend \u2192 SDK validation.",
      "runs": [
        "./.maestro/e2e.sh"
      ]
    },
    "e2e-inbox": {
      "file": "Makefile",
      "doc": null,
      "runs": [
        "./.maestro/e2e.sh --suite message-inbox"
      ]
    },
    "e2e-quick": {
      "file": "Makefile",
      "doc": null,
      "runs": [
        "./.maestro/e2e.sh --profile quick"
      ]
    },
    "e2e-setup": {
      "file": "Makefile",
      "doc": null,
      "runs": [
        "./.maestro/e2e.sh setup"
      ]
    },
    "format": {
      "file": "Makefile",
      "doc": "Run ktlint formatter to automatically fix many lint errors. Good to run this before checking for lint errors as this formatting might fix many issues.",
      "runs": [
        "./ktlint --format --android \"**/src/**/*.kt\" 2> /dev/null"
      ]
    },
    "generate-public-api": {
      "file": "Makefile",
      "doc": "Generate public API binary",
      "runs": [
        "./gradlew apiDump"
      ]
    },
    "lint": {
      "file": "Makefile",
      "doc": "format first, and then show lint errors that are left over.",
      "runs": [
        "make lint-install",
        "make format",
        "make lint-no-format"
      ]
    },
    "lint-error-message": {
      "file": "Makefile",
      "doc": null,
      "runs": [
        "echo \"\\n\\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\\nLooks like there are lint errors to fix.\\nRead the LINT.md document in this project to learn how to fix these problems.\\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\""
      ]
    },
    "lint-install": {
      "file": "Makefile",
      "doc": "How we install ktlint in the team.",
      "runs": [
        "./scripts/get-ktlint.sh"
      ]
    },
    "lint-no-format": {
      "file": "Makefile",
      "doc": "If there are no lint errors, the command will succeed and not show any error messages.",
      "runs": [
        "./ktlint --android \"**/src/**/*.kt\" 2> /dev/null || (make lint-error-message && false)"
      ]
    },
    "validate-public-api": {
      "file": "Makefile",
      "doc": "Run kotlin binary validator",
      "runs": [
        "./scripts/binary-validation.sh"
      ]
    }
  },
  "git_hooks": {
    "pre-commit": [
      {
        "name": "lint",
        "run": "make format && git add {staged_files}"
      },
      {
        "name": "binary-validation",
        "run": "make validate-public-api"
      }
    ],
    "pre-push": [
      {
        "name": "lint",
        "run": "make lint-no-format"
      }
    ]
  },
  "ci_workflows": [
    {
      "file": ".github/workflows/binary-validator.yml",
      "name": "Binary-validation",
      "triggers": [
        "push"
      ],
      "runs": [
        "./gradlew apiCheck"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/build-sample-app-for-sdk-release.yml",
      "name": "Build sample app for SDK release",
      "triggers": [
        "workflow_dispatch"
      ],
      "runs": [],
      "reusable_workflows": [
        "./.github/workflows/reusable_build_sample_apps.yml"
      ]
    },
    {
      "file": ".github/workflows/build-sample-apps.yml",
      "name": "Build sample apps",
      "triggers": [
        "pull_request"
      ],
      "runs": [],
      "reusable_workflows": [
        "./.github/actions/update-sample-app-comment",
        "./.github/workflows/reusable-release-policy.yml",
        "./.github/workflows/reusable_build_sample_apps.yml"
      ]
    },
    {
      "file": ".github/workflows/deploy-sdk.yml",
      "name": "Deploy SDK",
      "triggers": [
        "push"
      ],
      "runs": [
        "MODULE_VERSION=${{ needs.deploy-git-tag.outputs.new_release_version }} ./scripts/deploy-code.sh"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android",
        "./.github/workflows/build-sample-app-for-sdk-release.yml"
      ]
    },
    {
      "file": ".github/workflows/geofence-replay.yml",
      "name": "Geofence corpus replay",
      "triggers": [
        "pull_request"
      ],
      "runs": [
        "if ! ./gradlew :geofence:testDebugUnitTest --tests 'io.customer.geofence.replay.*' > \"$RUNNER_TEMP/gradle.log\" 2>&1; then",
        "python3 .github/scripts/geofence_replay_gate.py geofence/build/test-results/testDebugUnitTest .corpus/scenarios"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/lint.yml",
      "name": "Lint",
      "triggers": [
        "push"
      ],
      "runs": [
        "./gradlew :${{ matrix.module }}:lintDebug",
        "make lint-install && make lint-no-format"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/maestro-e2e.yml",
      "name": "Maestro SDK E2E",
      "triggers": [
        "pull_request"
      ],
      "runs": [
        "python3 .e2e-harness/scripts/redact_artifacts.py artifacts/e2e",
        "python3 .e2e-harness/scripts/redact_artifacts.py --check artifacts/e2e"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/manual-deployment.yml",
      "name": "Manual Deploy to Maven Central",
      "triggers": [
        "workflow_dispatch"
      ],
      "runs": [
        "MODULE_VERSION=${{ env.TAG }} ./scripts/deploy-code.sh"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/pr-helper.yml",
      "name": "Semantic PR helper",
      "triggers": [
        "pull_request"
      ],
      "runs": [],
      "reusable_workflows": []
    },
    {
      "file": ".github/workflows/reusable-release-policy.yml",
      "name": "Reusable release policy",
      "triggers": [
        "workflow_call"
      ],
      "runs": [
        "bash .github/scripts/validate-release-policy.sh"
      ],
      "reusable_workflows": []
    },
    {
      "file": ".github/workflows/reusable_build_sample_apps.yml",
      "name": "Reusable build sample apps workflow",
      "triggers": [
        "workflow_call"
      ],
      "runs": [
        "fastlane_build_args=\"{${sdk_version},${distribution_groups}}\"",
        "fastlane_build_args=\"{${distribution_groups}}\""
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android",
        "./.github/actions/update-sample-app-comment"
      ]
    },
    {
      "file": ".github/workflows/sdk-binary-size.yml",
      "name": "SDK Binary Size",
      "triggers": [
        "pull_request"
      ],
      "runs": [
        "./gradlew publishToMavenLocal",
        "./gradlew generateSdkSizeReport",
        "./gradlew publishToMavenLocal",
        "./gradlew compareSdkSizeReports -PcompareWith=\"$RUNNER_TEMP/sdk-size-base/sdk-binary-size.json\""
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/snapshot-release.yml",
      "name": "Publish Snapshot builds",
      "triggers": [
        "pull_request"
      ],
      "runs": [
        "./gradlew publishReleasePublicationToSonatypeRepository",
        "./scripts/update-gradle-compatibility.sh \\",
        "./gradlew :samples:java_layout:assembleRelease :samples:kotlin_compose:assembleRelease"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    },
    {
      "file": ".github/workflows/test.yml",
      "name": "Tests",
      "triggers": [
        "pull_request"
      ],
      "runs": [
        "./gradlew :messaginginapp:testDebugUnitTest",
        "./gradlew :${{ matrix.module }}:runJacocoTestReport"
      ],
      "reusable_workflows": [
        "./.github/actions/setup-android"
      ]
    }
  ],
  "agent_docs": [
    "AGENTS.md",
    "CLAUDE.md"
  ]
}
