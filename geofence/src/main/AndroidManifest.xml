<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Geofence monitoring requires these permissions declared in the host app:
        - android.permission.ACCESS_FINE_LOCATION
        - android.permission.ACCESS_BACKGROUND_LOCATION
        - android.permission.RECEIVE_BOOT_COMPLETED

        The SDK does not declare them to avoid adding permissions for customers
        not using geofencing.
    -->

    <application>
        <!-- Disabled by default; dynamically enabled by GeofenceManager when geofences are registered -->
        <receiver
            android:name="io.customer.geofence.GeofenceBroadcastReceiver"
            android:enabled="false"
            android:exported="false" />

        <!--
            Always enabled: its GMS PendingIntent outlives the process and the kill switch, and a
            delivery is what removes a stale request.
        -->
        <receiver
            android:name="io.customer.geofence.polygon.PolygonApproachReceiver"
            android:exported="false" />

        <!-- Receives fixes other apps requested. Always enabled, for the same reason as above. -->
        <receiver
            android:name="io.customer.geofence.polygon.PolygonPassiveReceiver"
            android:exported="false" />

        <!-- Disabled by default; enabled alongside GeofenceBroadcastReceiver -->
        <receiver
            android:name="io.customer.geofence.GeofenceBootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
