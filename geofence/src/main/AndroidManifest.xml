<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        Geofence monitoring requires these permissions declared in the host app:
        - android.permission.ACCESS_FINE_LOCATION
        - android.permission.ACCESS_BACKGROUND_LOCATION
        - android.permission.RECEIVE_BOOT_COMPLETED
        The SDK does not declare them to avoid adding permissions for customers
        not using geofencing.
    -->

    <application>
        <service
            android:name="io.customer.geofence.polygon.PolygonLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:ignore="ForegroundServicePermission" />
        <!-- Disabled by default; dynamically enabled by GeofenceManager when geofences are registered -->
        <receiver
            android:name="io.customer.geofence.GeofenceBroadcastReceiver"
            android:enabled="false"
            android:exported="false" />

        <!-- Receives the displacement-gated polygon approach fixes registered with GMS. -->
        <receiver
            android:name="io.customer.geofence.polygon.PolygonApproachReceiver"
            android:exported="false" />

        <!-- Disabled by default; enabled alongside GeofenceBroadcastReceiver -->
        <receiver
            android:name="io.customer.geofence.GeofenceBootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
